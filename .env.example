# Runtime mode. Use "production" only for deployed server processes.
NODE_ENV=development

# Public application base URL. Required when NODE_ENV=production.
APP_URL=

# Absolute path recommended in production. SQLite, uploads, the encrypted
# credential vault, vector memory, backups, and migration artifacts all live
# below this directory.
LIFEOS_DATA_DIR=

# Optional integrations. Leave blank to keep the provider disabled in development.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
GEMINI_API_KEY=
GITHUB_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MICROSOFT_TOKEN=
GOOGLE_TOKEN=
# Google Workspace OAuth Web application credentials. Prefer entering these in
# LifeOS Connections; never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Google Cloud authorized redirect URI. Keep this identical character for
# character, including localhost vs 127.0.0.1 and the port.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/google/oauth/callback
DATABASE_URL=
SMTP_URL=

# Keep the app on this computer unless an authenticated reverse proxy is used.
HOST=127.0.0.1

# Production refuses to start unless authentication is enabled and all three
# values below are configured. Generate the password hash with
# `npm run setup:auth`; never store a plaintext password.
LIFEOS_AUTH_REQUIRED=true
LIFEOS_AUTH_EMAIL=
LIFEOS_AUTH_PASSWORD_HASH=

# Generate once, store only in the protected environment, and retain it across
# restarts and deployments. Minimum 32 characters. Losing or changing it makes
# the encrypted integration vault unreadable.
LIFEOS_VAULT_SECRET=
